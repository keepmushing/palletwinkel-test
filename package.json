{
  "name": "palletje-website",
  "version": "1.0.0",
  "private": true,
  "description": "Statische website van 't Palletje. Geen dependencies, geen buildstap — server.js serveert enkel de bestanden in deze map.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf .next && mkdir -p .next && cp -R ./* .next/ && rm -rf .next/node_modules .next/package.json .next/server.js .next/serve.ps1 .next/controleer.ps1 .next/README.md .next/gereedschap .next/configurator/pallet-configurator-spec.md",
    "start": "node server.js"
  },
  "dependencies": {}
}
